def move_toward(current_x, current_y, target_x, target_y, speed, dt):
    """
    Moves an object toward a target at a fixed speed.

    Returns the object's new x and y coordinates.
    """

    dx = target_x - current_x
    dy = target_y - current_y

    distance = math.sqrt(dx * dx + dy * dy)

    if distance < 0.001:
        return target_x, target_y

    step = speed * dt

    if step >= distance:
        return target_x, target_y

    new_x = current_x + (dx / distance) * step
    new_y = current_y + (dy / distance) * step

    return new_x, new_y

def handle_goat_hit():
    """
    Called when the goat catches the player.

    The player loses one life and respawns at the dock.
    """

    global player_lives
    global player_exposure
    global game_state

    player_lives -= 1
    player_exposure = 100.0

    respawn_at_dock()

    if player_lives <= 0:

        game_state = "GAME_OVER"

        set_interaction_message(
            "GAME OVER — the wild goat caught you!",
            duration=999
        )

    else:

        set_interaction_message(
            f"The wild goat caught you! Lives remaining: {player_lives}"
        )

def update_goat(dt):
    """
    Updates the goat's AI.

    WAIT:
        Goat stays at its starting position until the player
        reaches Island B.

    CHASE:
        Once the player reaches Island B, the goat chases them.

    RETURN:
        If the player goes back to Island A, the goat returns
        to its patrol route.

    ATTACK:
        If the goat gets close enough to the player, the player
        loses a life and respawns at the dock.
    """

    global goat_pos
    global goat_patrol_index
    global goat_state
    global goat_attack_cooldown

    # --------------------------------------------------------
    # Attack cooldown
    # --------------------------------------------------------
    if goat_attack_cooldown > 0.0:
        goat_attack_cooldown -= dt

    # --------------------------------------------------------
    # Check whether player has reached Island B
    #
    # Island B:
    # x = 60 to 400
    # y = -250 to 250
    #
    # We use a slightly smaller safe area so the goat activates
    # once the player is clearly on the other island.
    # --------------------------------------------------------
    player_on_island_b = (
        player_pos[0] >= 80.0
        and -230.0 <= player_pos[1] <= 230.0
    )

    # --------------------------------------------------------
    # STATE 1: WAIT
    # --------------------------------------------------------
    if goat_state == "WAIT":

        # Goat remains completely stationary here.

        if player_on_island_b:

            goat_state = "CHASE"

            set_interaction_message(
                "WARNING! The wild goat spotted you!"
            )

    # --------------------------------------------------------
    # STATE 2: CHASE
    # --------------------------------------------------------
    elif goat_state == "CHASE":

        # If player leaves Island B, stop chasing.
        if not player_on_island_b:

            goat_state = "RETURN"

            set_interaction_message(
                "You escaped the goat. It is returning to patrol."
            )

        else:

            # Chase the player.
            goat_pos[0], goat_pos[1] = move_toward(
                goat_pos[0],
                goat_pos[1],
                player_pos[0],
                player_pos[1],
                goat_chase_speed,
                dt
            )

    # --------------------------------------------------------
    # STATE 3: RETURN
    # --------------------------------------------------------
    elif goat_state == "RETURN":

        # If the player enters Island B again before the goat
        # reaches its patrol point, start chasing again.
        if player_on_island_b:

            goat_state = "CHASE"

            set_interaction_message(
                "The wild goat is chasing you again!"
            )

        else:

            # Return to patrol point.
            target_x, target_y = goat_patrol_points[goat_patrol_index]

            goat_pos[0], goat_pos[1] = move_toward(
                goat_pos[0],
                goat_pos[1],
                target_x,
                target_y,
                goat_speed,
                dt
            )

            # Reached patrol point.
            if _distance(
                goat_pos[0],
                goat_pos[1],
                target_x,
                target_y
            ) < 2.0:

                goat_state = "WAIT"

    # --------------------------------------------------------
    # Check if goat caught the player
    # --------------------------------------------------------

    distance_to_player = _distance(
        goat_pos[0],
        goat_pos[1],
        player_pos[0],
        player_pos[1]
    )

    if distance_to_player <= goat_attack_radius:

        if goat_attack_cooldown <= 0.0:

            goat_attack_cooldown = 2.0

            handle_goat_hit()


def draw_goat():
    """
    Draws the wild goat using simple OpenGL primitives.

    Body:
        Cube

    Head:
        Sphere

    Horns:
        Cylinders

    Legs:
        Four small cubes

    Tail:
        Small sphere
    """

    x, y = goat_pos[0], goat_pos[1]

    glPushMatrix()

    glTranslatef(x, y, 0)

    # --------------------------------------------------------
    # Body
    # --------------------------------------------------------
    glColor3f(0.35, 0.25, 0.15)

    glPushMatrix()
    glTranslatef(0, 0, 28)
    glScalef(45, 20, 25)
    glutSolidCube(1)
    glPopMatrix()

    # --------------------------------------------------------
    # Head
    # --------------------------------------------------------
    glColor3f(0.45, 0.32, 0.20)

    glPushMatrix()
    glTranslatef(28, 0, 45)
    gluSphere(gluNewQuadric(), 15, 10, 10)
    glPopMatrix()

    # --------------------------------------------------------
    # Horn 1
    # --------------------------------------------------------
    glColor3f(0.85, 0.75, 0.55)

    glPushMatrix()
    glTranslatef(35, 10, 55)
    glRotatef(-35, 0, 1, 0)
    gluCylinder(
        gluNewQuadric(),
        4,
        1,
        18,
        8,
        8
    )
    glPopMatrix()

    # --------------------------------------------------------
    # Horn 2
    # --------------------------------------------------------
    glPushMatrix()
    glTranslatef(35, -10, 55)
    glRotatef(-35, 0, 1, 0)
    gluCylinder(
        gluNewQuadric(),
        4,
        1,
        18,
        8,
        8
    )
    glPopMatrix()

    # --------------------------------------------------------
    # Legs
    # --------------------------------------------------------
    glColor3f(0.25, 0.18, 0.12)

    leg_positions = [
        (-15, -8),
        (-15, 8),
        (15, -8),
        (15, 8)
    ]

    for lx, ly in leg_positions:

        glPushMatrix()

        glTranslatef(lx, ly, 10)

        glScalef(7, 7, 20)

        glutSolidCube(1)

        glPopMatrix()

    # --------------------------------------------------------
    # Tail
    # --------------------------------------------------------
    glColor3f(0.4, 0.3, 0.2)

    glPushMatrix()
    glTranslatef(-25, 0, 40)
    gluSphere(gluNewQuadric(), 7, 8, 8)
    glPopMatrix()

    glPopMatrix()

             
def draw_text(x, y, text, font=GLUT_BITMAP_HELVETICA_18):
    """Unchanged from template — screen-space text via orthographic overlay."""
    glColor3f(1, 1, 1)
    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0, 1000, 0, 800)

    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()

    glRasterPos2f(x, y)
    for ch in text:
        glutBitmapCharacter(font, ord(ch))

    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)


