def move_toward(current_x, current_y, target_x, target_y, speed, dt):
    dx = target_x - current_x
    dy = target_y - current_y
    distance = math.sqrt(dx * dx + dy * dy)
    if distance < 0.001:
        return target_x, target_y
    step = speed * dt
    if step >= distance:
        return target_x, target_y
    new_x = current_x + (dx / distance) * step
    new_y = current_y + (dy / distance) * step
    return new_x, new_y

def handle_goat_hit():
    global player_lives
    global player_exposure
    global game_state
    player_lives -= 1
    player_exposure = 100.0
    respawn_at_dock()
    if player_lives <= 0:
        game_state = "GAME_OVER"
        set_interaction_message("GAME OVER — the wild goat caught you!", duration=999)
    else:
        set_interaction_message(f"The wild goat caught you! Lives remaining: {player_lives}")

def update_goat(dt):
    global goat_pos
    global goat_patrol_index
    global goat_state
    global goat_attack_cooldown

    if goat_attack_cooldown > 0.0:
        goat_attack_cooldown -= dt

    player_on_island_b = (
        player_pos[0] >= 80.0
        and -230.0 <= player_pos[1] <= 230.0
    )

    if goat_state == "WAIT":
        if player_on_island_b:
            goat_state = "CHASE"
            set_interaction_message("WARNING! The wild goat spotted you!")

    elif goat_state == "CHASE":
        if not player_on_island_b:
            goat_state = "RETURN"
            set_interaction_message("You escaped the goat. It is returning to patrol.")
        else:
            goat_pos[0], goat_pos[1] = move_toward(
                goat_pos[0], goat_pos[1], player_pos[0], player_pos[1], goat_chase_speed, dt
            )

    elif goat_state == "RETURN":
        if player_on_island_b:
            goat_state = "CHASE"
            set_interaction_message("The wild goat is chasing you again!")
        else:
            target_x, target_y = goat_patrol_points[goat_patrol_index]
            goat_pos[0], goat_pos[1] = move_toward(
                goat_pos[0], goat_pos[1], target_x, target_y, goat_speed, dt
            )
            if _distance(goat_pos[0], goat_pos[1], target_x, target_y) < 2.0:
                goat_state = "WAIT"

    distance_to_player = _distance(goat_pos[0], goat_pos[1], player_pos[0], player_pos[1])
    if distance_to_player <= goat_attack_radius:
        if goat_attack_cooldown <= 0.0:
            goat_attack_cooldown = 2.0
            handle_goat_hit()


