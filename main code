# ---------- Rain storm effect ----------
MAX_RAIN_DROPS = 300
RAIN_MIN_SPEED = 180.0
RAIN_MAX_SPEED = 350.0
RAIN_TOP_HEIGHT = 420.0
RAIN_BOTTOM_HEIGHT = 0.0
rain_drops = []

def initialize_rain():
    global rain_drops
    rain_drops = []
    for _ in range(MAX_RAIN_DROPS):
        rain_drops.append([
            random.uniform(-450.0, 450.0),
            random.uniform(-350.0, 350.0),
            random.uniform(RAIN_BOTTOM_HEIGHT, RAIN_TOP_HEIGHT)
        ])

def update_rain(dt):
    storm_progress = 1.0 - (time_remaining / TIME_LIMIT)
    storm_progress = max(0.0, min(1.0, storm_progress))
    rain_speed = (
        RAIN_MIN_SPEED
        + (RAIN_MAX_SPEED - RAIN_MIN_SPEED) * storm_progress
    )
    for drop in rain_drops:
        drop[2] -= rain_speed * dt
        if drop[2] <= RAIN_BOTTOM_HEIGHT:
            drop[0] = random.uniform(-450.0, 450.0)
            drop[1] = random.uniform(-350.0, 350.0)
            drop[2] = RAIN_TOP_HEIGHT

def draw_rain():
    """
    Falling rain drawn as GL_POINTS — the same primitive type (and
    glPointSize usage) the template itself demonstrates for its single
    random point. GL_LINES is never used anywhere in the template, so
    drawing streaks with it would be an unlisted-function risk; a point
    per drop keeps this strictly inside the allowed primitive set.
    """
    if TIME_LIMIT <= 0 or not rain_drops:
        return
    storm_progress = 1.0 - (time_remaining / TIME_LIMIT)
    storm_progress = max(0.0, min(1.0, storm_progress))
    minimum_visible = 80
    visible_drops = int(
        minimum_visible
        + (MAX_RAIN_DROPS - minimum_visible) * storm_progress
    )
    glColor3f(0.65, 0.75, 0.9)
    glPointSize(3)
    glBegin(GL_POINTS)
    for i in range(visible_drops):
        x_offset, y_offset, z = rain_drops[i]
        x = player_pos[0] + x_offset
        y = player_pos[1] + y_offset
        glVertex3f(x, y, z)
    glEnd()

