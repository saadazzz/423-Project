        glPopMatrix()


def get_debris_position(d):
    """
    Current (x, y) for a debris piece, purely a function of elapsed_time —
    no per-frame state mutation needed, and it naturally freezes when
    the game is paused since elapsed_time itself stops advancing.
    """
    offset = d["amplitude"] * math.sin(elapsed_time * d["speed"])
    if d["axis"] == "y":
        return d["base_x"], d["base_y"] + offset
    return d["base_x"] + offset, d["base_y"]


def draw_debris():
    """Floating logs — cylinders rotated to lie flat, drifting back and forth."""
    glColor3f(0.35, 0.22, 0.12)
    for d in DEBRIS:
