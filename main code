# ============================================================
# PHASE 2 — PLAYER: MODEL, MOVEMENT, COLLISION
# Base movement (W/S/A/D) mirrors Assignment 3's control scheme,
# so it's necessary scaffolding but NOT counted as a scored
# feature on its own. Collision against static world geometry
# below IS new relative to A3 and counts as a feature.
# ============================================================

def draw_player():
    """Sphere head + cuboid body, with a small nose cuboid indicating facing direction."""
    glPushMatrix()
    glTranslatef(player_pos[0], player_pos[1], player_pos[2])
    glRotatef(player_angle, 0, 0, 1)

    glColor3f(0.2, 0.3, 0.6)  # torso
    glPushMatrix()
    glTranslatef(0, 0, 20)
    glScalef(20, 20, 40)
    glutSolidCube(1)
    glPopMatrix()

    glColor3f(0.9, 0.75, 0.6)  # head
    glPushMatrix()
    glTranslatef(0, 0, 48)
    gluSphere(gluNewQuadric(), 14, 10, 10)
    glPopMatrix()

    glColor3f(0.9, 0.2, 0.2)  # facing indicator
    glPushMatrix()
    glTranslatef(20, 0, 48)
    glScalef(12, 5, 5)
    glutSolidCube(1)
    glPopMatrix()

    glPopMatrix()


def _point_in_bounds(x, y, bounds, margin=20):
    x0, x1, y0, y1 = bounds
    return (x0 + margin) <= x <= (x1 - margin) and (y0 + margin) <= y <= (y1 - margin)


def _point_on_bridge(x, y):
    # x-edge (82) intentionally overlaps the island's own walkable edge
    # (±80, from ISLAND_*_BOUNDS margin) so there's no seam gap at the
    # island->bridge transition. y-edge (35) stays close to the visible
    # 130x60 plank (±65/±30) with just a small forgiving margin.
    bx, by, _ = BRIDGE_CENTER
    return (bx - 82) <= x <= (bx + 82) and (by - 35) <= y <= (by + 35)


def _distance(x1, y1, x2, y2):
    return math.sqrt((x1 - x2) ** 2 + (y1 - y2) ** 2)


def is_position_walkable(x, y):
    """
    Collision check against the static world. This is the piece that's
    genuinely new relative to Assignment 3 (which only checks bullet/enemy
    vs. player proximity, never player vs. static geometry).
    """
    # The bridge corridor overlaps both island collision margins. This is
    # important because the islands use a 20-unit safety margin, while the
    # bridge itself must provide a continuous path between them.
    on_solid_ground = (
        _point_in_bounds(x, y, ISLAND_A_BOUNDS)
        or _point_in_bounds(x, y, ISLAND_B_BOUNDS)
        or (bridge_anim >= 0.9 and _point_on_bridge(x, y))
    )
    if not on_solid_ground:
        return False  # would step into open water/gap

    # Rocks block movement
    for rx, ry, scale in ROCK_POSITIONS:
        if _distance(x, y, rx, ry) < (scale * 0.7 + 14):
            return False

    # Generator housing blocks movement
    gx, gy, _ = GENERATOR_POS
    if _distance(x, y, gx, gy) < 42:
        return False

    # Gate blocks movement until mostly open
    if gate_anim < 0.9:
        gxp, gyp, _ = GATE_POS
        if abs(x - gxp) < 14 and abs(y - gyp) < 38:
            return False

    # Drifting debris blocks movement wherever it currently sits
    for d in DEBRIS:
        dx, dy = get_debris_position(d)
        if _distance(x, y, dx, dy) < (d["radius"] + 14):
            return False

    return True


def try_move_player(dx, dy):
    """Attempts a move; rejects it entirely if the destination isn't walkable."""
    new_x = player_pos[0] + dx
    new_y = player_pos[1] + dy
    if is_position_walkable(new_x, new_y):
        player_pos[0] = new_x
        player_pos[1] = new_y


# ============================================================
# PHASE 4 — FUEL COLLECTION, GENERATOR, BRIDGE/GATE UNLOCK CHAIN
# ============================================================

def set_interaction_message(text, duration=2.5):
    global interaction_message, interaction_message_timer
    interaction_message = text
    interaction_message_timer = duration


def update_fuel_pickups():
    """Continuous overlap check — no key press needed, matching the proposal."""
    global fuel_collected, score, score_multiplier, last_fuel_pickup_time
    for canister in fuel_canisters:
        if canister["collected"]:
            continue
        cx, cy = canister["pos"]
        if _distance(player_pos[0], player_pos[1], cx, cy) < FUEL_PICKUP_RADIUS:
            canister["collected"] = True
            fuel_collected += 1

            if last_fuel_pickup_time is not None and (elapsed_time - last_fuel_pickup_time) <= COMBO_WINDOW:
                score_multiplier = min(MAX_MULTIPLIER, score_multiplier + 1)
            else:
                score_multiplier = 1
            last_fuel_pickup_time = elapsed_time

            score += 50 * score_multiplier
            combo_note = f" x{score_multiplier} combo!" if score_multiplier > 1 else ""
            set_interaction_message(f"Fuel collected! ({fuel_collected}/{fuel_required}){combo_note}")


def try_interact():
    """
    Called on E key press. Generator activation and the victory
    beacon both respond here, gated by their own conditions.
    """
    gx, gy, _ = GENERATOR_POS
    if not generator_on and _distance(player_pos[0], player_pos[1], gx, gy) < INTERACT_RANGE:
        if cheat_infinite_fuel or fuel_collected >= fuel_required:
            activate_generator()
        else:
            set_interaction_message(
                f"NOT ENOUGH FUEL. Required: {fuel_required}, Collected: {fuel_collected}"
            )
        return

    lx, ly, _ = LIGHTHOUSE_POS
    if gate_open and _distance(player_pos[0], player_pos[1], lx, ly) < BEACON_INTERACT_RANGE:
        trigger_victory()


def trigger_victory():
    """
    Only reachable once the gate is open (which itself required the
    bridge risen, which required the generator, which required fuel) —
    so there's no way to skip straight to the win condition.
    """
    global game_state, score
    if game_state != "PLAYING":
        return
    game_state = "VICTORY"
    score += 500
    set_interaction_message(f"LIGHTHOUSE RESTORED! Final Score: {score}", duration=999)


def get_current_objective():
    """Whatever the player needs to do next, computed from existing state — no new flags."""
    if not generator_on:
        return "Generator", GENERATOR_POS
    if bridge_anim < 0.99:
        return "Bridge (still rising)", BRIDGE_CENTER
    if not gate_open:
        return "Lighthouse Gate", GATE_POS
    return "Beacon", LIGHTHOUSE_POS


def show_compass():
    """
    Directional readout to the current objective — computed on demand
    from coordinates Claude already has, not a new HUD element that's
    always on screen (unlike A3's static stat display).
    """
    name, pos = get_current_objective()
    tx, ty, _ = pos
    dx = tx - player_pos[0]
    dy = ty - player_pos[1]
    dist = math.sqrt(dx * dx + dy * dy)

    target_angle = math.degrees(math.atan2(dy, dx))
    rel = (target_angle - player_angle + 180) % 360 - 180  # normalize to -180..180

    if -45 <= rel <= 45:
        direction = "AHEAD"
    elif 45 < rel <= 135:
        direction = "LEFT"
    elif -135 <= rel < -45:
        direction = "RIGHT"
    else:
        direction = "BEHIND"

    set_interaction_message(f"Next: {name} — {direction}, {int(dist)}m away", duration=3.0)


def activate_generator():
    """
    Flips one shared state flag that both the bridge and (eventually)
    the gate check — this single flag is what creates the
    explore -> collect -> progress dependency chain.

    Note: this intentionally does NOT rotate the player's facing angle.
    Auto-turning the player would hijack camera control the instant E
    is pressed, which feels like a glitch rather than a designed
    moment. Use Q (compass) instead to get a bearing to the bridge.
    """
    global generator_on, bridge_open, score
    generator_on = True
    bridge_open = True
    score += 200
    set_interaction_message("GENERATOR ACTIVATED — bridge is rising! (Press Q for a bearing)", duration=3.5)


def update_barriers(dt):
    """
    Advances bridge_anim/gate_anim toward their target (open) state
    over time, and checks whether the gate's own unlock condition
    (bridge risen + player near the gate) has been met.
    """
    global bridge_anim, gate_anim, gate_open

    if bridge_open and bridge_anim < 1.0:
        bridge_anim = min(1.0, bridge_anim + BARRIER_ANIM_SPEED * dt)

    if not gate_open and bridge_anim >= 0.9:
        gxp, gyp, _ = GATE_POS
        if _distance(player_pos[0], player_pos[1], gxp, gyp) < GATE_TRIGGER_RANGE:
            gate_open = True
            set_interaction_message("The lighthouse gate slides open.")

    if gate_open and gate_anim < 1.0:
        gate_anim = min(1.0, gate_anim + BARRIER_ANIM_SPEED * dt)


# ============================================================
# PHASE 5 — RISING TIDE & FLOODING HAZARD (exposure meter)
# Duration-based hazard: standing in an active flood zone drains
# `player_exposure` continuously rather than an instant hit-based
# life loss. A life is only lost once it's fully depleted,
# at which point the player respawns at the dock and it refills.
# This is the structural difference from Assignment 3's system,
# which decrements a life on a single touch event.
# ============================================================

def is_player_in_flood_zone():
    """True if the player currently stands in a coastal strip that's underwater."""
    px, py = player_pos[0], player_pos[1]
    for x0, x1, y0, y1, threshold in FLOOD_ZONES:
        if water_level <= threshold:
            continue
        if x0 <= px <= x1 and y0 <= py <= y1:
            return True
    return False


def respawn_at_dock():
    """Sends the player back to the dock spawn point after exposure depletes."""
    global player_angle
    player_pos[0], player_pos[1], player_pos[2] = -340.0, 0.0, 0.0
    player_angle = 90.0


def handle_exposure_depleted():
    """
    Exposure hit zero: lose a life, refill the meter, respawn at the
    dock. If no lives remain, the run ends — full Game Over handling
    (state transitions, restart) is fleshed out in Phase 6.
    """
    global player_lives, player_exposure, game_state

    player_lives -= 1
    player_exposure = 100.0
    respawn_at_dock()

    if player_lives <= 0:
        game_state = "GAME_OVER"
        set_interaction_message("GAME OVER — the storm claimed the island.", duration=999)
    else:
        set_interaction_message(f"Swept back to the dock! Lives remaining: {player_lives}")


def update_exposure(dt):
    """Drains exposure while flooded, regenerates on dry ground."""
    global player_exposure

    if is_player_in_flood_zone():
        player_exposure -= EXPOSURE_DRAIN_RATE * dt
    else:
        player_exposure += EXPOSURE_REGEN_RATE * dt

    player_exposure = max(0.0, min(100.0, player_exposure))

    if player_exposure <= 0.0:
        handle_exposure_depleted()


# ============================================================
# PHASE 8 — POLISH: LIGHTNING FLASH, SCORE MULTIPLIER (above),
# CHEAT MODES (F / T)
# ============================================================

def update_lightning(dt):
    """
    Schedules random lightning flashes. The gap between flashes shrinks
    as time_remaining drops (urgency), so flashes get more frequent as
    the storm intensifies — purely a function of elapsed_time, no
    glutTimerFunc involved.
    """
    global next_lightning_time, lightning_flash_timer

    if elapsed_time >= next_lightning_time:
        lightning_flash_timer = LIGHTNING_FLASH_DURATION
        urgency = time_remaining / TIME_LIMIT if TIME_LIMIT > 0 else 0.0
        min_gap = 2.0
        max_gap = 3.0 + 7.0 * urgency  # up to 10s early on, down to ~3s late game
        next_lightning_time = elapsed_time + random.uniform(min_gap, max_gap)


def draw_lightning_flash():
    """
    Full-screen flash using the same orthographic-overlay technique
    draw_text() already uses (gluOrtho2D + GL_QUADS) — avoids
    glClearColor/blending, neither of which is in the template.
    """
    if lightning_flash_timer <= 0.0:
        return

    glMatrixMode(GL_PROJECTION)
    glPushMatrix()
    glLoadIdentity()
    gluOrtho2D(0, 1000, 0, 800)

    glMatrixMode(GL_MODELVIEW)
    glPushMatrix()
    glLoadIdentity()

    glColor3f(0.85, 0.9, 1.0)
    glBegin(GL_QUADS)
    glVertex3f(0, 0, 0)
    glVertex3f(1000, 0, 0)
    glVertex3f(1000, 800, 0)
    glVertex3f(0, 800, 0)
    glEnd()

    glPopMatrix()
    glMatrixMode(GL_PROJECTION)
    glPopMatrix()
    glMatrixMode(GL_MODELVIEW)


def setupCamera():
    """
    Third-person camera that follows behind and above the player,
    recalculated every frame from player_pos/player_angle via gluLookAt.
    """
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluPerspective(fovY, 1.25, 0.1, 1500)
    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()

    rad = math.radians(player_angle)
    cam_x = player_pos[0] - camera_follow_distance * math.cos(rad)
    cam_y = player_pos[1] - camera_follow_distance * math.sin(rad)
    cam_z = player_pos[2] + camera_follow_height

    gluLookAt(cam_x, cam_y, cam_z,
              player_pos[0], player_pos[1], player_pos[2] + 30,
              0, 0, 1)


def keyboardListener(key, x, y):
    """
    W/S move forward/backward along the player's current facing angle.
    A/D rotate the player. This scheme mirrors A3's controls (necessary
    scaffolding, not a scored feature) — collision (is_position_walkable)
    is the actual new piece layered on top.

    R (restart) always works. P (pause/resume) works from PLAYING or
    PAUSED. Movement/interact only apply while actively PLAYING.
    """
    global player_angle, game_state, is_zoomed, fovY
    global cheat_infinite_fuel, cheat_tide_freeze

    if key == b'r':
        reset_game_state()
        return

    if key == b'p':
        if game_state == "PLAYING":
            game_state = "PAUSED"
            set_interaction_message("PAUSED", duration=999)
        elif game_state == "PAUSED":
            game_state = "PLAYING"
            set_interaction_message("Resumed.")
        return

    if game_state != "PLAYING":
        return

    rad = math.radians(player_angle)

    if key == b'w':
        try_move_player(player_speed * math.cos(rad), player_speed * math.sin(rad))
    elif key == b's':
        try_move_player(-player_speed * math.cos(rad), -player_speed * math.sin(rad))
    elif key == b'a':
        player_angle = (player_angle + 5) % 360
    elif key == b'd':
        player_angle = (player_angle - 5) % 360
    elif key == b'e':
        try_interact()
    elif key == b'c':
        is_zoomed = not is_zoomed
        fovY = fovY_zoomed if is_zoomed else fovY_default
    elif key == b'q':
        show_compass()
    elif key == b'f':
        cheat_infinite_fuel = not cheat_infinite_fuel
        set_interaction_message(f"[CHEAT] Infinite Fuel: {'ON' if cheat_infinite_fuel else 'OFF'}")
    elif key == b't':
        cheat_tide_freeze = not cheat_tide_freeze
        set_interaction_message(f"[CHEAT] Tide Freeze: {'ON' if cheat_tide_freeze else 'OFF'}")


def specialKeyListener(key, x, y):
    """Arrow keys — reserved for future camera height/orbit adjustments if needed."""
    pass


def mouseListener(button, state, x, y):
    """Reserved — not needed for current feature set, kept for template compliance."""
    pass


def idle():
    """
    Core loop driver. Computes delta time manually since glutTimerFunc
    is not allowed. All time-based systems (tide, timer, drifting debris,
    lightning) will read `elapsed_time` or the per-frame `dt` computed here.
    """
    global last_frame_time, elapsed_time, time_remaining, water_level
    global interaction_message_timer, game_state, beacon_rotation
    global lightning_flash_timer

    now = time.time()
    if last_frame_time is None:
        last_frame_time = now
    dt = now - last_frame_time
    last_frame_time = now

    if game_state == "PLAYING":
        elapsed_time += dt

        # Countdown timer ticks down
        time_remaining = max(0.0, time_remaining - dt)
        if time_remaining <= 0.0:
            game_state = "GAME_OVER"
            set_interaction_message("GAME OVER — the storm has arrived!", duration=999)

        # Rising tide — flooding hazard logic lives in update_exposure()
        if not cheat_tide_freeze:
            water_level += water_rise_rate * dt

        # Phase 4 systems
        update_fuel_pickups()
        update_barriers(dt)

        update_goat(dt)

        # Rain storm effect
        update_rain(dt)

        # Phase 5 system
        update_exposure(dt)

        # Phase 8 system
        update_lightning(dt)

        if lightning_flash_timer > 0.0:
            lightning_flash_timer = max(0.0, lightning_flash_timer - dt)

        if interaction_message_timer > 0.0:
            interaction_message_timer = max(0.0, interaction_message_timer - dt)

    elif game_state == "VICTORY":
        # Beacon keeps spinning on the victory screen even though
        # everything else (timer, tide, movement) is frozen.
        beacon_rotation = (beacon_rotation + BEACON_ROTATION_SPEED * dt) % 360

    glutPostRedisplay()


def showScreen():
    """
    Display function. Now draws the full static world (Phase 1) in
    addition to the Phase 0 scaffolding/placeholder HUD.
    """
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
    glLoadIdentity()
    glViewport(0, 0, 1000, 800)

    setupCamera()
    draw_world()
    draw_player()
    draw_rain()
    draw_lightning_flash()

    # HUD
    draw_text(10, 770, f"Lighthouse Keeper: Before the Storm | state: {game_state}")
    draw_text(10, 740, f"Time Remaining: {int(time_remaining)}")
    draw_text(10, 710, f"Water Level: {water_level:.1f}   Exposure: {int(player_exposure)}/100")
    mult_note = f" (x{score_multiplier} combo)" if score_multiplier > 1 else ""
    draw_text(10, 680, f"Lives: {player_lives}   Fuel: {fuel_collected}/{fuel_required}   Score: {score}{mult_note}")
    draw_text(10, 650, f"Generator: {'ON' if generator_on else 'OFF'}   Gate: {'OPEN' if gate_open else 'CLOSED'}")

    cheat_note = ""
    if cheat_infinite_fuel or cheat_tide_freeze:
        active = []
        if cheat_infinite_fuel:
            active.append("INF FUEL")
        if cheat_tide_freeze:
            active.append("TIDE FREEZE")
        cheat_note = "   [CHEATS: " + ", ".join(active) + "]"
    draw_text(10, 620, "Controls: W/S move, A/D turn, E interact, C zoom, Q compass, F/T cheats, P pause, R restart" + cheat_note)

    if interaction_message_timer > 0.0:
        draw_text(10, 590, interaction_message)

    if game_state == "PAUSED":
        draw_text(420, 420, "== PAUSED ==")
        draw_text(370, 390, "Press P to resume, R to restart")
    elif game_state == "GAME_OVER":
        draw_text(400, 420, "== GAME OVER ==")
        draw_text(360, 390, f"Final Score: {score}   Press R to restart")
    elif game_state == "VICTORY":
        draw_text(390, 420, "== LIGHTHOUSE RESTORED! ==")
        draw_text(360, 390, f"Final Score: {score}   Press R to play again")

    glutSwapBuffers()


def main():
    reset_game_state()

    glutInit()
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH)
    glutInitWindowSize(1000, 800)
    glutInitWindowPosition(0, 0)
    glutCreateWindow(b"Lighthouse Keeper: Before the Storm")

    glutDisplayFunc(showScreen)
    glutKeyboardFunc(keyboardListener)
    glutSpecialFunc(specialKeyListener)
    glutMouseFunc(mouseListener)
    glutIdleFunc(idle)

    glutMainLoop()


if __name__ == "__main__":
    main()
