def draw_island_terrain():
    """Two separate landmasses with a gap between them (the future bridge site)."""
    ax0, ax1, ay0, ay1 = ISLAND_A_BOUNDS
    bx0, bx1, by0, by1 = ISLAND_B_BOUNDS

    glPushMatrix()
    glColor3f(0.55, 0.45, 0.25)  # sandy brown — Island A
    glBegin(GL_QUADS)
    glVertex3f(ax0, ay0, 0)
    glVertex3f(ax1, ay0, 0)
    glVertex3f(ax1, ay1, 0)
    glVertex3f(ax0, ay1, 0)
    glEnd()

    glColor3f(0.45, 0.5, 0.3)  # slightly greener — Island B
    glBegin(GL_QUADS)
    glVertex3f(bx0, by0, 0)
    glVertex3f(bx1, by0, 0)
    glVertex3f(bx1, by1, 0)
    glVertex3f(bx0, by1, 0)
    glEnd()
    glPopMatrix()


def draw_water():
    """
    Large water plane surrounding both islands. Height reads from
    `water_level`, incremented every frame in idle().
    """
    glPushMatrix()
    glColor3f(0.1, 0.35, 0.65)
    z = -10 + water_level
    glBegin(GL_QUADS)
    glVertex3f(-600, -600, z)
    glVertex3f(600, -600, z)
    glVertex3f(600, 600, z)
    glVertex3f(-600, 600, z)
    glEnd()
    glPopMatrix()


def draw_flood_zones():
    """
    Visual overlay for each coastal strip that's currently underwater
    (water_level has passed that zone's threshold). Drawn as a
    slightly-raised blue quad directly over the affected ground so
    the hazard is visible before the player steps into it.
    """
    for x0, x1, y0, y1, threshold in FLOOD_ZONES:
        if water_level <= threshold:
            continue
        glPushMatrix()
        glColor3f(0.15, 0.45, 0.75)
        glBegin(GL_QUADS)
        glVertex3f(x0, y0, 1.5)
        glVertex3f(x1, y0, 1.5)
        glVertex3f(x1, y1, 1.5)
        glVertex3f(x0, y1, 1.5)
        glEnd()
        glPopMatrix()


