        glPushMatrix()
        glTranslatef(x, y, 6)
        glRotatef(90, 0, 1, 0)
        gluCylinder(gluNewQuadric(), d["radius"] * 0.6, d["radius"] * 0.6, 45, 10, 10)
        glPopMatrix()


